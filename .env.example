APP_NAME="Laravel Base"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily: her gün ayrı dosya, LOG_DAILY_DAYS gün sonra silinir.
# single kullanılırsa laravel.log hiç dönmez ve zamanla diski doldurur —
# dolduğunda yükleme, yedekleme ve oturum yazımı da durur.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Canlıda 'error' önerilir; 'debug' her isteği yazar.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravelbase
DB_USERNAME=root
DB_PASSWORD=

# Demo hesapların (admin/editor/user @example.com) şifresi.
# Boş bırakılırsa config/seeding.php içindeki varsayılan kullanılır.
SEED_PASSWORD=Demo*12345.

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Oturum verisinin saklanma biçimi: php | migrate | json
#
# Varsayılan `json`. PHP'nin serialize biçimi veri okurken nesne de kuruyor;
# saklanan dizgeyi değiştirebilen biri uygulamadaki sınıflardan zincir kurup
# kod çalıştırabiliyor. JSON'da bu yüzey yok.
#
# YENİ KURULUM: dokunmayın, `json` doğru.
#
# ÇALIŞAN KURULUM: doğrudan `json`'a geçmek o an açık olan bütün oturumları
# okunamaz hâle getirir ve herkes çıkış yapar. Bunun yerine:
#   1. SESSION_SERIALIZATION=migrate  (okuma iki biçimi de kabul eder,
#      yazma JSON'a döner — kimse düşmez)
#   2. SESSION_LIFETIME kadar süre bekleyin (varsayılan 120 dakika)
#   3. SESSION_SERIALIZATION=json     (geçiş bitti, unserialize yolu kapandı)
# SESSION_SERIALIZATION=json
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Oturum çerezi yalnız HTTPS üzerinden gönderilsin.
#
# HTTPS'li her kurulumda AÇIN. Kapalıyken çerez düz HTTP isteğine de
# ekleniyor; aynı ağdaki biri onu okuyup oturumu devralabiliyor. Laravel'in
# varsayılanı yok (config/session.php: env('SESSION_SECURE_COOKIE')), yani
# yazılmadığı sürece kapalı sayılıyor.
#
# Yerelde `true` bırakmayın: http://localhost üzerinden çerez hiç kurulmaz ve
# giriş yapılamaz — üstelik hata da vermez, form sessizce başa döner.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=uploads
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Çizilmiş parça önbelleği (gezinti gibi her sayfada aynı çıkan bloklar).
# Yalnız oturumu olmayan GET isteklerinde devreye giriyor; kişiye özel iz
# taşıyan çıktı hiçbir koşulda saklanmıyor.
# CACHE_FRAGMENTS=true

MEMCACHED_HOST=127.0.0.1

# ── İçerik güvenlik politikası ──────────────────────────────────────────────
# XSS'e karşı ikinci savunma hattı. Politika nonce tabanlı ve varsayılan olarak
# uygulanıyor. Yeni bir üçüncü taraf betiği eklerken önce rapor moduna alıp
# (CSP_REPORT_ONLY=true) ihlalleri izlemek, siteyi kırma riskini ortadan
# kaldırıyor — ihlaller /csp-ihlali ucundan loga düşüyor.
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false
# CSP_REPORT_ROUTE=true
# CSP_REPORT_RATE_LIMIT=30
# Projeye eklenen araçların alan adları (virgülle ayrılır):
# CSP_EXTRA_SCRIPT=
# CSP_EXTRA_STYLE=
# CSP_EXTRA_IMG=
# CSP_EXTRA_FONT=
# CSP_EXTRA_CONNECT=
# CSP_EXTRA_FRAME=

# ── SEO denetleyici ─────────────────────────────────────────────────────────
# Karakter sınırları tek kaynak: sunucu doğrulaması, formdaki sayaç ve
# denetleyici bu sayıları okuyor. Değerler arama sonucunun gerçek davranışından
# geliyor — başlık ~60, açıklama 160 karakterden sonra kırpılıyor.
# SEO_TITLE_MIN=30
# SEO_TITLE_MAX=60
# SEO_DESCRIPTION_MIN=70
# SEO_DESCRIPTION_MAX=160
# SEO_SLUG_MAX=75
# Bu kelime sayısının altı "ince içerik" sayılıyor (yalnız öneri seviyesinde):
# SEO_THIN_CONTENT_WORDS=150
# Toplu denetim ekranının önbellek ömrü (saniye):
# SEO_AUDIT_CACHE_TTL=900

# ── Liste dışa aktarma ──────────────────────────────────────────────────────
# CSV varsayılanları Türkçe Excel'e göre: noktalı virgül ayracı, virgüllü
# ondalık ve UTF-8 BOM. Başka yerel ayara kurulan projede değiştirilir.
# EXPORT_CSV_DELIMITER=;
# EXPORT_CSV_DECIMAL_SEPARATOR=,
# EXPORT_CSV_BOM=true
# PDF satır tavanı (Excel ve CSV tavansız):
# EXPORT_PDF_ROW_LIMIT=5000

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=


# Ziyaretçi adına konuşmasına izin verilen proxy'ler (virgülle ayrılmış adres
# veya CIDR aralığı). Boş bırakılırsa iletilen başlıklara hiç bakılmaz — siteye
# doğrudan erişiliyorsa doğrusu budur. Cloudflare/nginx arkasında mutlaka
# doldurulmalı, yoksa tüm ziyaretçiler tek IP görünür ve rate limit tek kovaya
# düşer. Sunucuya yalnızca proxy üzerinden erişilebiliyorsa '*' kullanılabilir.
TRUSTED_PROXIES=

# Yönlendirme hedefi olarak izin verilen harici host'lar (virgülle ayrılmış).
# Boş bırakılırsa yalnızca site içi yollar ve APP_URL host'u kabul edilir.
REDIRECT_ALLOWED_HOSTS=

# Debugbar (yalnızca local geliştirmede true)
DEBUGBAR_ENABLED=false

# ── API (Sanctum) ─────────────────────────────────────────────────────────
# Oturum çerezini kabul eden alan adları (virgülle ayrılmış). Yalnızca KENDİ
# web ön yüzünüz yazılır; mobil uygulama buraya girmez, o Bearer jetonuyla
# gelir. Boş bırakılırsa localhost + APP_URL varsayılır.
SANCTUM_STATEFUL_DOMAINS=

# Jeton ömrü (dakika). Varsayılan 43200 = 30 gün. Boş bırakma: null yazmak
# jetonu sonsuz geçerli kılar.
SANCTUM_TOKEN_EXPIRATION=43200

# Üretilen jetonların öneki — sızıntı taramaları jetonu bundan tanır.
SANCTUM_TOKEN_PREFIX=

# CORS: API'yi tarayıcıdan çağıracak kaynaklar (virgülle ayrılmış tam origin,
# ör. https://app.ornek.com). '*' herkese açık demek; jeton taşıyan bir API'de
# sorun değil. Ama CORS_SUPPORTS_CREDENTIALS=true ise (çerezli SPA) mutlaka
# doldurulmalı — tarayıcı '*' ile çerez göndermeyi reddeder.
CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=86400

# Hız sınırları (istek/dakika). Giriş e-posta+IP başına, kayıt ve iletişim
# formu IP başına sayılır.
API_RATE_LIMIT=60
API_RATE_LIMIT_LOGIN=5
API_RATE_LIMIT_REGISTER=3
API_RATE_LIMIT_CONTACT=3
API_RATE_LIMIT_PASSWORD=5
API_RATE_LIMIT_VERIFICATION=3
API_RATE_LIMIT_COMMENT=3
API_RATE_LIMIT_NEWSLETTER=5

# API onbellegi (saniye) — ETag ile birlikte, seyrek degisen uclar icin.
API_CACHE_MAX_AGE=60

# ── Yedeğin dış kopyası ──────────────────────────────────────────────────────
# Yedek, yedeklediği veriyle aynı diskte durursa diski kaybeden yedeği de
# kaybeder. İkinci bir hedef tanımlayın:
#
#   local → başka bir yol (bağlanan ağ klasörü, ikinci disk)
#   ftp   → başka bir sunucu (PHP'nin kendi ftp eklentisiyle)
#
# Kapalıyken (none) yedekleme eskisi gibi çalışır, yalnız ikinci kopya alınmaz.
BACKUP_OFFSITE_DRIVER=none
BACKUP_OFFSITE_PATH=
BACKUP_OFFSITE_RETENTION_DAYS=30

BACKUP_OFFSITE_FTP_HOST=
BACKUP_OFFSITE_FTP_PORT=21
BACKUP_OFFSITE_FTP_USERNAME=
BACKUP_OFFSITE_FTP_PASSWORD=
BACKUP_OFFSITE_FTP_PATH=backups
BACKUP_OFFSITE_FTP_PASSIVE=true

# ── Sosyal giriş (Google / Apple) ────────────────────────────────────────────
# NOT: Bu bölümdeki ve aşağıdaki bildirim/reCAPTCHA anahtarlarının hepsi
# panelden de girilebiliyor: Yönetim → API ve Servisler. Panelde dolu olan
# alan buradakini eziyor, boş bırakılan alan için buradaki geçerli kalıyor.
# Panelden girmek sunucuya dokunmayı gerektirmiyor ve gizli anahtarlar
# şifrelenerek saklanıyor.
# Mobil akış: uygulama sağlayıcının SDK'sıyla kimlik jetonu alır, sunucu
# imzayı doğrular. İstemci sırrı gerekmez; gereken tek şey jetonun kime
# düzenlendiği. Virgülle birden çok istemci kimliği yazılabilir (iOS, Android,
# web ayrı kimlik taşır ve üçü de aynı hesaba girer).
#
#   Google → Google Cloud Console → Kimlik bilgileri → OAuth istemci kimlikleri
#   Apple  → Bundle ID (mobil) ve/veya Services ID (web)
#
# Boş bırakılan sağlayıcı kapalıdır.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ── Mobil bildirimler ────────────────────────────────────────────────────────
# Jeton kaydı yapılandırma istemez ve kutudan çıkar çıkmaz çalışır; burası
# yalnız gönderim tarafı. Tanımsızken jetonlar kaydedilir, bildirim gönderilmez
# ve bu log'a düşer.
PUSH_DRIVER=null

# Firebase Cloud Messaging — HTTP v1.
#
# Eski sürüm (FCM_SERVER_KEY + /fcm/send) Google tarafından Haziran 2024'te
# kapatıldı. v1 OAuth2 istiyor ve gereken tek şey servis hesabı JSON'u:
#
#   Firebase Console → Proje ayarları → Hizmet hesapları
#   → "Yeni özel anahtar oluştur" → inen dosyayı storage/app/ altına koyun
#
# Dosya depoya GİRMEMELİ (storage/app zaten .gitignore'da). Yol proje köküne
# göre yazılabilir. Proje kimliği JSON'un içinde; FCM_PROJECT_ID yalnız onu
# ezmek gerekirse.
#
# PUSH_DRIVER=fcm
FCM_CREDENTIALS=
# FCM_PROJECT_ID=
PUSH_PRUNE_AFTER_DAYS=180
