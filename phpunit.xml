<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Suite'in tepe belleği 140 MB'ı aşıyor (1700 test, her biri kendi
             uygulama örneğiyle). PHP'nin stok CLI sınırı 128 MB olduğu için
             `composer test` klonlayan geliştiricinin makinesinde yarıda
             düşüyordu; sınır burada bildiriliyor ki sunucunun php.ini'sine
             dokunmak gerekmesin. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Forwarded headers are only trusted when a test says so -->
        <env name="TRUSTED_PROXIES" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Uploads go to a throwaway folder so tests never touch public/uploads -->
        <env name="UPLOADS_PATH" value="./storage/framework/testing/uploads"/>
        <!-- Same for backups: create() rotates old archives away, so a test
             run must never see a developer's real backup directory -->
        <env name="BACKUPS_PATH" value="./storage/framework/testing/backups"/>
    </php>
</phpunit>
